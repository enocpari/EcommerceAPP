@model EcommerceApp.Models.Product
@{
    ViewData["Title"] = $"{Model.Name} — Ficha Técnica";
    var isCel = (Model.Category ?? "").ToLower().Contains("celular");
    var discount = Model.WasPrice.HasValue && Model.WasPrice > Model.Price
        ? Math.Round((1 - Model.Price / Model.WasPrice.Value) * 100)
        : 0;
}

<section class="section" style="padding-top:20px;">
<div class="container" style="max-width:1040px">
    <!-- Breadcrumbs -->
    <nav class="meta" style="margin-bottom:18px;display:flex;align-items:center;gap:6px;">
        <a asp-controller="Home" asp-action="Index" style="color:var(--muted)">Inicio</a>
        <span>/</span>
        <a asp-controller="Products" asp-action="Index" style="color:var(--muted)">Catálogo</a>
        <span>/</span>
        <span style="color:var(--fg);font-weight:600">@Model.Name</span>
    </nav>

    <div class="grid-2-1" style="gap:36px;align-items:start;">
        <!-- Visual Presentation -->
        <div class="card" style="padding:32px;display:grid;place-items:center;background:var(--surface);position:relative;border-radius:24px;min-height:420px;overflow:hidden">
            @if (!string.IsNullOrEmpty(Model.Badge))
            {
                <span class="badge" style="position:absolute;top:18px;left:18px;background:var(--fg);color:var(--surface);font-family:var(--font-mono);font-size:11px;padding:5px 10px;border-radius:999px;">@Model.Badge</span>
            }
            @if (Model.Stock == 0)
            {
                <span class="badge" style="position:absolute;top:18px;left:18px;background:#dc2626;color:white;font-family:var(--font-mono);font-size:11px;padding:5px 10px;border-radius:999px;">Agotado</span>
            }

            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" alt="@Model.Name" style="max-width:90%;max-height:360px;object-fit:contain;" onerror="this.src='/images/default-product.jpg'" />
            }
            else if (isCel)
            {
                <svg width="140" height="140" viewBox="0 0 44 44" fill="none"><rect x="11" y="3" width="22" height="38" rx="5" stroke="var(--fg)" stroke-width="1.2"/><rect x="15" y="8" width="14" height="2" rx="1" fill="var(--muted)"/><circle cx="22" cy="34" r="1.6" stroke="var(--muted)"/><rect x="14" y="13" width="16" height="16" rx="2" fill="color-mix(in oklch, var(--accent) 12%, transparent)" stroke="var(--border)"/></svg>
            }
            else
            {
                <svg width="140" height="140" viewBox="0 0 44 44" fill="none"><path d="M8 18c0-7 6-11 14-11s14 4 14 11v6c0 2-1 3-2.5 4L22 35 10.5 28C9 27 8 26 8 24v-6z" stroke="var(--fg)" stroke-width="1.2"/><path d="M8 22c0 2 1 3 2.5 4L22 33l11.5-7C35 25 36 24 36 22" stroke="var(--muted)" stroke-width="1"/><circle cx="22" cy="19" r="5" fill="color-mix(in oklch, var(--accent) 12%, transparent)" stroke="var(--border)"/></svg>
            }
        </div>

        <!-- Product Specs & Purchase -->
        <div class="stack" style="gap:18px">
            <div>
                <div class="eyebrow" style="margin-bottom:6px;">@(Model.Brand ?? "NODO") · @(isCel ? "Celular Original" : "Auriculares de Alta Fidelidad")</div>
                <h1 class="h1" style="font-size:clamp(26px, 3vw, 36px);">@Model.Name</h1>
                @if (!string.IsNullOrEmpty(Model.Spec))
                {
                    <div style="font-family:var(--font-mono);font-size:13.5px;color:var(--muted);margin-top:6px;">@Model.Spec</div>
                }
            </div>

            <!-- Price and Discount -->
            <div style="padding:16px 20px;background:var(--surface);border:1px solid var(--border);border-radius:14px;">
                <div class="meta" style="margin-bottom:4px;">Precio oficial contado / cuotas:</div>
                <div class="row" style="align-items:baseline;gap:12px;flex-wrap:wrap">
                    <span class="num" style="font-size:32px;font-weight:700;color:var(--fg)">
                        $@Model.Price.ToString("N0", new System.Globalization.CultureInfo("es-AR"))
                    </span>
                    @if (Model.WasPrice.HasValue && Model.WasPrice > Model.Price)
                    {
                        <span class="num" style="font-size:16px;color:var(--muted);text-decoration:line-through">
                            $@Model.WasPrice.Value.ToString("N0", new System.Globalization.CultureInfo("es-AR"))
                        </span>
                        <span class="pill" style="font-size:12px;">-@discount% OFF</span>
                    }
                </div>
                <div class="meta" style="margin-top:6px;color:var(--accent);font-weight:600;">
                    ✓ Hasta 12 cuotas fijas de $@((Model.Price / 12).ToString("N0", new System.Globalization.CultureInfo("es-AR"))) con tarjetas bancarias
                </div>
            </div>

            <!-- Stock status -->
            <div class="row" style="gap:8px;font-size:13px;">
                @if (Model.Stock > 5)
                {
                    <span class="stock-dot dot-green"></span>
                    <span style="color:#16a34a;font-weight:600">Stock disponible para entrega inmediata (@Model.Stock unid.)</span>
                }
                else if (Model.Stock > 0)
                {
                    <span class="stock-dot dot-amber"></span>
                    <span style="color:#d97706;font-weight:600">Stock crítico: ¡Últimas @Model.Stock unidades!</span>
                }
                else
                {
                    <span class="stock-dot dot-red"></span>
                    <span style="color:#dc2626;font-weight:600">Sin existencias en este momento</span>
                }
            </div>

            <!-- Actions -->
            <div class="stack" style="gap:10px;">
                <button type="button" class="btn btn-accent p-add" 
                        style="width:100%;padding:14px;font-size:15px;" 
                        data-id="@Model.Id" 
                        data-name="@Model.Name" 
                        data-price="@Model.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)" 
                        data-brand="@(Model.Brand ?? "")" 
                        data-category="@(Model.Category ?? "")" 
                        data-spec="@(Model.Spec ?? "")" 
                        data-image="@(Model.ImageUrl ?? "")"
                        onclick="window.NodoCart.addFromButton(this)">
                    Agregar al carrito de compras →
                </button>
                <div class="row" style="gap:10px;">
                    <button class="btn btn-secondary" style="flex:1;" onclick="window.NodoUI.openDrawer('soporteDrawer')">
                        Consultar con un asesor
                    </button>
                    <a asp-action="Index" class="btn btn-ghost" style="padding-inline:16px;">
                        ← Catálogo
                    </a>
                </div>
            </div>

            <!-- Description -->
            <div style="border-top:1px solid var(--border);padding-top:18px;">
                <strong style="font-size:13px;letter-spacing:0.04em;text-transform:uppercase;font-family:var(--font-mono);color:var(--muted)">Descripción y Uso Recomendado</strong>
                <p class="lead" style="font-size:14.5px;margin-top:8px;line-height:1.6;color:var(--fg)">@Model.Description</p>
            </div>

            <!-- Trust highlights -->
            <div class="trustbar" style="margin-top:0;">
                <span>◐ Entrega <b>24 h en CABA</b></span>
                <span>◑ Garantía <b>12 meses oficial</b></span>
                <span>◒ Devolución <b>30 días cambio directo</b></span>
            </div>

            @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Admin"))
            {
                <div class="card" style="background:var(--bg);border-radius:12px;padding:14px;margin-top:8px;">
                    <span class="meta" style="font-weight:600;">Acciones de Administrador:</span>
                    <div class="row" style="gap:8px;margin-top:8px;">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-secondary btn-sm">Editar este producto</a>
                        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-ghost btn-sm" style="color:var(--accent)">Eliminar de base de datos</a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
</section>