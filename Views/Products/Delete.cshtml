@model EcommerceApp.Models.Product
@{
    ViewData["Title"] = $"Eliminar {Model.Name} · NODO";
}

<section class="section" style="padding-top:20px;">
<div class="container" style="max-width:540px;">
    <div class="card" style="padding:32px 24px;border-radius:20px;border-color:rgba(220,38,38,0.2);">
        <div style="width:48px;height:48px;border-radius:50%;background:#fee2e2;color:#dc2626;display:grid;place-items:center;font-size:22px;margin-bottom:16px;">
            ⚠️
        </div>
        <h2 class="h2" style="font-size:22px;">¿Eliminar producto?</h2>
        <p class="meta" style="margin-top:6px;">Esta acción retirará el artículo inmediatamente del catálogo público.</p>

        <div style="background:var(--bg);border:1px solid var(--border);border-radius:14px;padding:16px;margin-block:18px;">
            <div class="meta">@(Model.Brand ?? "NODO") · @(Model.Category?.Name ?? Model.CategoryName ?? "Producto")</div>
            <strong style="font-size:16px;display:block;margin-top:2px;">@Model.Name</strong>
            <div class="num" style="font-size:18px;font-weight:700;margin-top:4px;">
                $@Model.Price.ToString("N0", new System.Globalization.CultureInfo("es-AR"))
            </div>
            <div class="meta" style="margin-top:4px;">Stock registrado: @Model.Stock unidades</div>
        </div>

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />
            <div class="row" style="gap:10px;">
                <button type="submit" class="btn" style="background:#dc2626;color:white;padding:11px 20px;">
                    Confirmar eliminación
                </button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>
</section>