@model List<EcommerceApp.Models.Product>
@{
    ViewData["Title"] = "Tecnología que sí entiendes";
}

<!-- HERO SPLIT -->
<section class="section hero" id="hero">
    <div class="container">
        <div class="hero-split">
            <div>
                <p class="eyebrow">NUEVO EN @StoreConfig.GetSettings().BrandName.ToUpper() · ENTREGA EN 24 H · 12 CUOTAS SIN INTERÉS</p>
                <h1 class="h1">Celulares y auriculares que <span style="color:var(--accent)">sí entiendes.</span></h1>
                <p class="lead" style="margin-top:16px">Curamos los mejores modelos: solo iPhone, Galaxy, Pixel y el audio más galardonado. Probados, con 12 meses de garantía oficial y cambio en 30 días. Sin letra chica.</p>
                <div class="hero-actions">
                    <a asp-controller="Products" asp-action="Index" class="btn btn-accent btn-lg">Explorar catálogo completo →</a>
                    <button class="btn btn-secondary btn-lg" onclick="window.NodoUI.openDrawer('soporteDrawer')">Asesoría gratuita</button>
                    <span class="meta" style="display:inline-flex;align-items:center;gap:6px;margin-left:4px">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="color-mix(in oklch, var(--accent) 80%, black)" stroke="none"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                        <b>4.8/5</b> · 2.431 compradores verificados
                    </span>
                </div>
                <div class="trustbar">
                    <span>◐ Envío gratis <b>Desde $@StoreConfig.GetSettings().FreeShippingThreshold.ToString("N0")</b></span>
                    <span>◑ Garantía <b>12 meses oficial</b></span>
                    <span>◒ Cuotas <b>Hasta 12 sin interés</b></span>
                </div>
            </div>

            <!-- HERO SHOWCASE - PRODUCTOS DESTACADOS EN ROTACIÓN -->
            <div class="hero-showcase">
                <div class="hero-showcase-glow"></div>
                
                <div class="hero-showcase-top">
                    <span class="pill" style="gap:6px;">
                        <span class="status-dot"></span> Selección Destacada
                    </span>
                    <div class="hero-dots">
                        <button type="button" class="hero-dot active" onclick="window.NodoHero?.setSlide(0)" title="Ver Galaxy S24 Ultra" aria-label="Ver Galaxy S24 Ultra"></button>
                        <button type="button" class="hero-dot" onclick="window.NodoHero?.setSlide(1)" title="Ver Auriculares Hi-Fi" aria-label="Ver Auriculares Hi-Fi"></button>
                    </div>
                </div>

                <!-- Escenario con alternancia de imágenes PNG -->
                <div class="hero-stage">
                    <!-- Producto 1: Samsung Galaxy S24 Ultra -->
                    <div class="hero-slide active" data-index="0" onclick="location.href='/Products'">
                        <div class="hero-img-wrap">
                            <img src="~/images/hero-phone.png" alt="Samsung Galaxy S24 Ultra" class="hero-product-img" />
                        </div>
                        <div class="hero-slide-info">
                            <div class="hero-slide-title">
                                <strong>Samsung Galaxy S24 Ultra</strong>
                                <span class="tag">Gama Alta · 12 cuotas</span>
                            </div>
                            <div class="hero-slide-desc">Titanium Black · Snapdragon 8 Gen 3 · Pantalla Dynamic AMOLED 2X</div>
                        </div>
                    </div>

                    <!-- Producto 2: Auriculares Hi-Fi Wireless -->
                    <div class="hero-slide" data-index="1" onclick="location.href='/Products'">
                        <div class="hero-img-wrap">
                            <img src="~/images/hero-headphones.png" alt="Auriculares Wireless High-End" class="hero-product-img" />
                        </div>
                        <div class="hero-slide-info">
                            <div class="hero-slide-title">
                                <strong>Auriculares Wireless Hi-Fi</strong>
                                <span class="tag" style="color:var(--accent);border-color:var(--accent);font-weight:600">Audio Espacial</span>
                            </div>
                            <div class="hero-slide-desc">Cancelación Activa de Ruido Pro · 30 h batería · Drivers High-End</div>
                        </div>
                    </div>
                </div>

                <div class="hero-showcase-bottom">
                    <div style="display:flex;align-items:center;gap:6px;">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                        <span class="meta" style="font-size:12px;color:var(--fg);font-weight:600;">12 Meses Garantía Oficial Escrita</span>
                    </div>
                    <a asp-controller="Products" asp-action="Index" class="btn btn-secondary btn-sm">
                        Ver en catálogo →
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- SELECCIÓN DESTACADA -->
<section class="section" style="padding-top:10px;">
    <div class="container">
        <div class="row-between" style="flex-wrap:wrap;margin-bottom:24px;">
            <div>
                <p class="eyebrow">DESTACADOS · CALIDAD GARANTIZADA</p>
                <h2 class="h2">Los favoritos de nuestra comunidad</h2>
                <p class="lead" style="margin-top:6px;">Tecnología probada en el mundo real, con entrega inmediata.</p>
            </div>
            <a asp-controller="Products" asp-action="Index" class="btn btn-secondary btn-sm">Ver todo el catálogo (16 modelos) →</a>
        </div>

        <div class="grid-4">
            @if (Model != null && Model.Any())
            {
                foreach (var p in Model)
                {
                    var isCel = (p.Category?.Name ?? p.CategoryName ?? "").ToLower().Contains("celular");
                    var discount = p.WasPrice.HasValue && p.WasPrice > p.Price
                        ? Math.Round((1 - p.Price / p.WasPrice.Value) * 100)
                        : 0;

                    <article class="p-card">
                        <div class="p-visual" onclick='window.NodoUI.openPdp({id:@p.Id, name:"@p.Name", brand:"@p.Brand", category:"@(p.Category?.Name ?? p.CategoryName ?? "")", price:@p.Price, wasPrice:@(p.WasPrice.HasValue ? p.WasPrice.Value.ToString(System.Globalization.CultureInfo.InvariantCulture) : "null"), spec:"@p.Spec", desc:"@p.Description", imageUrl:"@p.ImageUrl", badge:"@p.Badge"})' style="cursor:pointer">
                            @if (!string.IsNullOrEmpty(p.Badge))
                            {
                                <span class="badge">@p.Badge</span>
                            }
                            else if (p.Stock == 0)
                            {
                                <span class="badge" style="background:#dc2626">Sin stock</span>
                            }
                            @if (!string.IsNullOrEmpty(p.ImageUrl))
                            {
                                <img src="@p.ImageUrl" alt="@p.Name" onerror="this.src='/images/default-product.jpg'" />
                            }
                            else if (isCel)
                            {
                                <svg width="56" height="56" viewBox="0 0 44 44" fill="none"><rect x="11" y="3" width="22" height="38" rx="5" stroke="var(--fg)" stroke-width="1.3"/><rect x="15" y="8" width="14" height="2" rx="1" fill="var(--muted)"/><circle cx="22" cy="34" r="1.6" stroke="var(--muted)"/><rect x="14" y="13" width="16" height="16" rx="2" fill="color-mix(in oklch, var(--accent) 10%, transparent)" stroke="var(--border)"/></svg>
                            }
                            else
                            {
                                <svg width="56" height="56" viewBox="0 0 44 44" fill="none"><path d="M8 18c0-7 6-11 14-11s14 4 14 11v6c0 2-1 3-2.5 4L22 35 10.5 28C9 27 8 26 8 24v-6z" stroke="var(--fg)" stroke-width="1.3"/><path d="M8 22c0 2 1 3 2.5 4L22 33l11.5-7C35 25 36 24 36 22" stroke="var(--muted)" stroke-width="1"/><circle cx="22" cy="19" r="5" fill="color-mix(in oklch, var(--accent) 10%, transparent)" stroke="var(--border)"/></svg>
                            }
                        </div>
                        <div class="p-body">
                            <div class="meta">@(p.Brand ?? "NODO") · @(isCel ? "Celular" : "Auricular")</div>
                            <div class="p-title">@p.Name</div>
                            <div class="p-spec">@(p.Spec ?? p.Description)</div>
                            <div class="p-price">
                                <span class="now">$@p.Price.ToString("N0", new System.Globalization.CultureInfo("es-AR"))</span>
                                @if (p.WasPrice.HasValue && p.WasPrice > p.Price)
                                {
                                    <span class="was">$@p.WasPrice.Value.ToString("N0", new System.Globalization.CultureInfo("es-AR"))</span>
                                    <span class="off">-@discount%</span>
                                }
                            </div>
                            <button type="button" class="btn btn-accent p-add btn-sm btn-block" 
                                data-id="@p.Id" 
                                data-name="@p.Name" 
                                data-price="@p.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)" 
                                data-brand="@(p.Brand ?? "")" 
                                data-category="@(p.Category?.Name ?? p.CategoryName ?? "")" 
                                data-spec="@(p.Spec ?? "")" 
                                data-image="@(p.ImageUrl ?? "")"
                                onclick="window.NodoCart.addFromButton(this)">
                                Agregar al carrito
                            </button>
                            <a asp-controller="Products" asp-action="Details" asp-route-id="@p.Id" class="btn btn-ghost btn-sm btn-block" style="margin-top:8px;text-align:center;">
                                Ver detalle completo →
                            </a>
                        </div>
                    </article>
                }
            }
        </div>
    </div>
</section>

<!-- SECCIÓN SERVICIO & SOPORTE HUMANO -->
<section class="section" id="soporte" style="background:var(--surface);border-top:1px solid var(--border);border-bottom:1px solid var(--border);">
    <div class="container grid-2" style="align-items:center;gap:36px;">
        <div>
            <p class="eyebrow">SERVICIO & CONFIANZA · @StoreConfig.GetSettings().BrandName.ToUpper() HUMAN TOUCH</p>
            <h2 class="h2">Te explicamos la tecnología sin tecnicismos innecesarios.</h2>
            <p class="lead" style="margin-top:12px;">Comprar un smartphone o unos auriculares de gama alta no debería ser confuso. Nuestros especialistas prueban cada equipo y te aconsejan según lo que realmente usas: cámara nocturna, duración de batería para viajes o cancelación de ruido para oficina.</p>
            <div class="row" style="margin-top:20px;gap:12px;flex-wrap:wrap">
                <button class="btn btn-accent btn-lg" onclick="window.NodoUI.openDrawer('soporteDrawer')">Consultar por WhatsApp / Chat →</button>
                <a asp-controller="Home" asp-action="Privacy" class="btn btn-secondary btn-lg">Conocer garantías @StoreConfig.GetSettings().BrandName</a>
            </div>
        </div>
        <div class="card" style="padding:26px;border-radius:20px;background:var(--bg);">
            <h3 class="h3" style="font-size:18px;">¿Por qué elegir @StoreConfig.GetSettings().BrandName?</h3>
            <div class="stack" style="gap:14px;margin-top:16px;font-size:13.5px;">
                <div class="row" style="gap:12px;align-items:flex-start">
                    <span style="font-size:18px;">🛡️</span>
                    <div>
                        <strong>12 Meses de Garantía Oficial Escrita</strong>
                        <div class="meta" style="margin-top:2px;">Cubre cualquier falla de fábrica con cambio directo durante los primeros 30 días.</div>
                    </div>
                </div>
                <div class="row" style="gap:12px;align-items:flex-start">
                    <span style="font-size:18px;">⚡</span>
                    <div>
                        <strong>Envíos Prioritarios y Seguros</strong>
                        <div class="meta" style="margin-top:2px;">Embalaje protegido anti-golpes y seguimiento en tiempo real con seguro total.</div>
                    </div>
                </div>
                <div class="row" style="gap:12px;align-items:flex-start">
                    <span style="font-size:18px;">💳</span>
                    <div>
                        <strong>Planes de Cuotas Transparentes</strong>
                        <div class="meta" style="margin-top:2px;">Aceptamos todas las tarjetas, transferencias bancarias con descuento y MercadoPago.</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
