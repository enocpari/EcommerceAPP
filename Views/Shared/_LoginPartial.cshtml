@using Microsoft.AspNetCore.Identity
@using EcommerceApp.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<div class="nav-auth-group">
@if (SignInManager.IsSignedIn(User))
{
    <div class="nav-auth-user">
        <span class="meta hide-m" style="font-size:12.5px;color:var(--fg);font-weight:600;max-width:140px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">
            @(User.Identity?.Name?.Split('@')[0] ?? "Mi Cuenta")
        </span>
        @if (User.IsInRole("Admin"))
        {
            <span class="pill hide-m" style="font-size:9.5px;padding:2px 6px;">Admin</span>
        }
        <a asp-controller="Orders" asp-action="MyOrders" class="btn btn-ghost btn-sm nav-btn-auth hide-m" style="font-size:12px;padding:0 8px;" title="Ver mis compras">
            Mis Pedidos
        </a>
        <form asp-controller="Account" asp-action="Logout" method="post" style="display:inline-flex;margin:0;">
            <button type="submit" class="btn btn-ghost btn-sm nav-btn-auth" style="font-size:12px;padding:0 10px;" title="Cerrar Sesión">
                Salir ↗
            </button>
        </form>
    </div>
}
else
{
    <a class="btn btn-ghost btn-sm nav-btn-auth" asp-controller="Account" asp-action="Login">
        Entrar
    </a>
    <a class="btn btn-primary btn-sm hide-m nav-btn-register" asp-controller="Account" asp-action="Register">
        Registrarse
    </a>
}
</div>


