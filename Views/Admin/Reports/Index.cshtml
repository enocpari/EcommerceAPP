@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Reportes y Análisis";
}

<div style="max-width:1200px">
    <div class="row-between" style="flex-wrap:wrap;margin-bottom:24px;">
        <div>
            <p class="eyebrow">MÓDULO DE REPORTERÍA · NODO ADMIN</p>
            <h1 class="h1" style="font-size:28px;">Generar Reportes</h1>
        </div>
    </div>

    <div class="grid-3" style="gap:20px;margin-bottom:28px;">
        <!-- REPORTE DE VENTAS -->
        <div class="card" style="padding:24px;border:1px solid var(--border);border-radius:16px;transition:box-shadow 0.2s,transform 0.2s;" onmouseover="this.style.boxShadow='0 8px 32px rgba(0,0,0,0.12)';this.style.transform='translateY(-2px)'" onmouseout="this.style.boxShadow='';this.style.transform=''">
            <div style="display:flex;align-items:center;gap:12px;margin-bottom:16px;">
                <div style="width:48px;height:48px;border-radius:12px;background:linear-gradient(135deg,#16a34a,#15803d);display:grid;place-items:center;color:white;font-size:22px;">
                    📊
                </div>
                <div>
                    <h3 class="h3" style="margin:0;font-size:18px;">Reporte de Ventas</h3>
                    <p class="meta" style="margin:2px 0 0;">Pedidos, clientes, métodos de pago y totales</p>
                </div>
            </div>
            <p class="meta" style="font-size:13px;line-height:1.5;margin-bottom:20px;color:var(--muted);">
                Filtra por rango de fechas y estado del pedido. Incluye cabecera con logo y fecha de generación, detalle tabular con bordes y pie con totales, productos vendidos y ticket promedio.
            </p>
            <form method="get" asp-action="Sales" style="display:flex;flex-direction:column;gap:12px;margin-bottom:16px;">
                <div class="row" style="gap:8px;flex-wrap:wrap;">
                    <div style="flex:1;min-width:140px;">
                        <label class="meta" style="font-size:11px;display:block;margin-bottom:4px;">Fecha Inicial</label>
                        <input type="date" name="startDate" class="input" style="padding:8px 12px;font-size:12.5px;border-radius:8px;" />
                    </div>
                    <div style="flex:1;min-width:140px;">
                        <label class="meta" style="font-size:11px;display:block;margin-bottom:4px;">Fecha Final</label>
                        <input type="date" name="endDate" class="input" style="padding:8px 12px;font-size:12.5px;border-radius:8px;" />
                    </div>
                    <div style="flex:1;min-width:140px;">
                        <label class="meta" style="font-size:11px;display:block;margin-bottom:4px;">Estado</label>
                        <select name="status" class="select" style="padding:8px 12px;font-size:12.5px;border-radius:8px;">
                            <option value="all">Todos los estados</option>
                            <option value="Pendiente">Pendiente</option>
                            <option value="Pago Acreditado">Pago Acreditado</option>
                            <option value="En Preparación">En Preparación</option>
                            <option value="En Camino">En Camino</option>
                            <option value="Entregado">Entregado</option>
                            <option value="Cancelado">Cancelado</option>
                        </select>
                    </div>
                </div>
                <div class="row" style="gap:8px;">
                    <button type="submit" formaction="/Admin/Reports/Sales" class="btn btn-secondary btn-sm" style="flex:1;">Ver en pantalla</button>
                    <button type="submit" formaction="/Admin/Reports/SalesPdf" class="btn btn-accent btn-sm" style="flex:1;">⬇ Descargar PDF</button>
                </div>
            </form>
        </div>

        <!-- REPORTE DE PRODUCTOS -->
        <div class="card" style="padding:24px;border:1px solid var(--border);border-radius:16px;transition:box-shadow 0.2s,transform 0.2s;" onmouseover="this.style.boxShadow='0 8px 32px rgba(0,0,0,0.12)';this.style.transform='translateY(-2px)'" onmouseout="this.style.boxShadow='';this.style.transform=''">
            <div style="display:flex;align-items:center;gap:12px;margin-bottom:16px;">
                <div style="width:48px;height:48px;border-radius:12px;background:linear-gradient(135deg,#2563eb,#1d4ed8);display:grid;place-items:center;color:white;font-size:22px;">
                    📱
                </div>
                <div>
                    <h3 class="h3" style="margin:0;font-size:18px;">Reporte de Productos</h3>
                    <p class="meta" style="margin:2px 0 0;">Catálogo completo con precios, stock y ofertas</p>
                </div>
            </div>
            <p class="meta" style="font-size:13px;line-height:1.5;margin-bottom:20px;color:var(--muted);">
                Lista todos los productos con ID, nombre, marca, categoría, especificación, precio, stock, estado y si está en oferta. Pie con totales, activos, agotados y valor de inventario.
            </p>
            <div class="row" style="gap:8px;">
                <a asp-action="Products" class="btn btn-secondary btn-sm" style="flex:1;">Ver en pantalla</a>
                <a asp-action="ProductsPdf" class="btn btn-accent btn-sm" style="flex:1;">⬇ Descargar PDF</a>
            </div>
        </div>

        <!-- REPORTE DE INVENTARIO -->
        <div class="card" style="padding:24px;border:1px solid var(--border);border-radius:16px;transition:box-shadow 0.2s,transform 0.2s;" onmouseover="this.style.boxShadow='0 8px 32px rgba(0,0,0,0.12)';this.style.transform='translateY(-2px)'" onmouseout="this.style.boxShadow='';this.style.transform=''">
            <div style="display:flex;align-items:center;gap:12px;margin-bottom:16px;">
                <div style="width:48px;height:48px;border-radius:12px;background:linear-gradient(135deg,#7c3aed,#6d28d9);display:grid;place-items:center;color:white;font-size:22px;">
                    📦
                </div>
                <div>
                    <h3 class="h3" style="margin:0;font-size:18px;">Reporte de Inventario</h3>
                    <p class="meta" style="margin:2px 0 0;">Stock, valor unitario y clasificación visual</p>
                </div>
            </div>
            <p class="meta" style="font-size:13px;line-height:1.5;margin-bottom:20px;color:var(--muted);">
                Productos ordenados por stock. Clasificación visual: AGOTADO (0), STOCK BAJO (≤5), DISPONIBLE (>5). Valor en inventario = Stock × Precio. Pie con resumen completo.
            </p>
            <div class="row" style="gap:8px;">
                <a asp-action="Inventory" class="btn btn-secondary btn-sm" style="flex:1;">Ver en pantalla</a>
                <a asp-action="InventoryPdf" class="btn btn-accent btn-sm" style="flex:1;">⬇ Descargar PDF</a>
            </div>
        </div>
    </div>

    <!-- Nota informativa -->
    <div class="card" style="background:var(--bg);border:1px solid var(--border);border-radius:12px;padding:16px;font-size:12.5px;">
        <div class="row" style="gap:8px;align-items:flex-start;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" style="flex-shrink:0;margin-top:1px;"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
            <div>
                <strong>Nota:</strong> Los reportes se generan en tiempo real consultando la base de datos PostgreSQL (Supabase) mediante Entity Framework Core.
                Las plantillas utilizan <strong>FastReport OpenSource</strong> (.frx) y exportan a PDF nativo.
                Para la actividad universitaria, el <strong>Reporte de Ventas</strong> cumple con Header (logo, título, fecha), Detail (tabla con bordes) y Footer (agregaciones: total pedidos, productos vendidos, ventas totales, ticket promedio, paginación).
            </div>
        </div>
    </div>
</div>