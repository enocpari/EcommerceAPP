@model EcommerceApp.Services.StoreSettingsModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Ajustes de Marca y Tienda";
}

<div style="margin-bottom:24px;">
    <div class="row-between">
        <div>
            <h1 class="h2">Ajustes de Marca y Tienda</h1>
            <p class="meta" style="font-size:13.5px;margin-top:4px;">Modifica el nombre de la marca, identidad visual, textos y políticas de la tienda en tiempo real.</p>
        </div>
        <a asp-controller="Home" asp-action="Index" target="_blank" class="btn btn-secondary btn-sm">
            Ver Tienda en Vivo ↗
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div style="background:#e6f9ed;border:1px solid #95e1b2;color:#1e7e44;padding:12px 18px;border-radius:12px;margin-bottom:20px;font-size:13.5px;display:flex;align-items:center;gap:10px;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>
        <span>@TempData["SuccessMessage"]</span>
    </div>
}

<div class="grid-2-1" style="gap:28px;">
    <!-- FORMULARIO DE CONFIGURACIÓN -->
    <div class="card" style="padding:28px;">
        <form asp-action="Settings" method="post" id="settingsForm">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger" style="margin-bottom:14px;font-size:13px;"></div>

            <div style="font-size:14px;font-weight:700;letter-spacing:-0.01em;margin-bottom:16px;display:flex;align-items:center;gap:8px;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
                Identidad de Marca
            </div>

            <div class="grid-2" style="gap:16px;margin-bottom:16px;">
                <div class="field">
                    <label class="label" asp-for="BrandName">Nombre de la Marca</label>
                    <input asp-for="BrandName" class="input" id="inputBrandName" placeholder="Ej: NOVA, NEXUS, AURA" required />
                    <span asp-validation-for="BrandName" class="text-danger" style="font-size:12px;"></span>
                </div>
                <div class="field">
                    <label class="label" asp-for="LogoInitial">Inicial / Letra del Logo</label>
                    <input asp-for="LogoInitial" class="input" id="inputLogoInitial" maxlength="3" placeholder="Ej: N" />
                    <span class="meta" style="font-size:11px;">Aparecerá en el isotipo de la barra superior.</span>
                </div>
            </div>

            <div class="field" style="margin-bottom:20px;">
                <label class="label" asp-for="Tagline">Subtítulo / Slogan de Marca</label>
                <input asp-for="Tagline" class="input" id="inputTagline" placeholder="Ej: Celulares & Audio High-End" />
                <span class="meta" style="font-size:11px;">Visible junto al logotipo y en el pie de página.</span>
            </div>

            <div style="border-top:1px solid var(--border);padding-top:20px;margin-top:20px;">
                <div style="font-size:14px;font-weight:700;letter-spacing:-0.01em;margin-bottom:16px;display:flex;align-items:center;gap:8px;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                    Contacto y Soporte
                </div>

                <div class="grid-2" style="gap:16px;margin-bottom:16px;">
                    <div class="field">
                        <label class="label" asp-for="SupportPhone">Teléfono / WhatsApp de Asistencia</label>
                        <input asp-for="SupportPhone" class="input" placeholder="+54 11 4500-8000" />
                    </div>
                    <div class="field">
                        <label class="label" asp-for="SupportEmail">Email de Atención al Cliente</label>
                        <input asp-for="SupportEmail" type="email" class="input" placeholder="contacto@tienda.com" />
                    </div>
                </div>

                <div class="grid-2" style="gap:16px;margin-bottom:20px;">
                    <div class="field">
                        <label class="label" asp-for="FreeShippingThreshold">Monto Mínimo Envío Gratis ($ ARS)</label>
                        <input asp-for="FreeShippingThreshold" type="number" step="1000" class="input" id="inputShippingThreshold" />
                    </div>
                    <div class="field">
                        <label class="label" asp-for="Instagram">Usuario de Redes Sociales</label>
                        <input asp-for="Instagram" class="input" placeholder="@@tienda.oficial" />
                    </div>
                </div>
            </div>

            <div class="row" style="justify-content:flex-end;gap:12px;border-top:1px solid var(--border);padding-top:20px;">
                <button type="submit" class="btn btn-primary" style="padding:10px 24px;">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
                    Guardar Cambios de Marca
                </button>
            </div>
        </form>
    </div>

    <!-- VISTA PREVIA EN VIVO -->
    <div>
        <div class="card" style="padding:22px;position:sticky;top:84px;">
            <div class="eyebrow" style="margin-bottom:8px;">VISTA PREVIA EN VIVO</div>
            <h3 style="font-size:15px;font-weight:600;margin-bottom:14px;">Así lucirá tu Cabecera</h3>
            
            <div style="background:var(--bg);border:1px solid var(--border);border-radius:14px;padding:14px;display:flex;flex-direction:column;gap:12px;">
                <div style="display:flex;align-items:center;justify-content:space-between;padding:10px 14px;background:var(--surface);border:1px solid var(--border);border-radius:10px;">
                    <div style="display:flex;align-items:center;gap:8px;">
                        <span id="previewMark" style="width:26px;height:26px;border-radius:8px;background:var(--fg);color:var(--surface);display:grid;place-items:center;font-size:12px;font-weight:700;">
                            @Model.LogoInitial
                        </span>
                        <div>
                            <div id="previewName" style="font-family:var(--font-display);font-weight:700;font-size:14px;line-height:1;">
                                @Model.BrandName
                            </div>
                            <div id="previewTagline" style="font-size:9.5px;color:var(--muted);margin-top:2px;">
                                @Model.Tagline
                            </div>
                        </div>
                    </div>
                    <span class="pill" style="font-size:9px;padding:2px 6px;">Tienda Activa</span>
                </div>

                <div style="font-size:11.5px;color:var(--muted);line-height:1.4;background:var(--surface);padding:10px 12px;border-radius:8px;border:1px solid var(--border);">
                    <div><strong>Envío gratuito:</strong> A partir de <span class="num" id="previewShipping">$@Model.FreeShippingThreshold.ToString("N0")</span></div>
                    <div style="margin-top:4px;"><strong>Contacto:</strong> @Model.SupportPhone</div>
                </div>
            </div>

            <div style="margin-top:16px;font-size:12px;color:var(--muted);line-height:1.45;">
                ℹ️ Los cambios guardados se reflejan inmediatamente en la barra de navegación, el logo, el pie de página, y todas las vistas del sitio.
            </div>
        </div>
    </div>
</div>

<script>
    const nameInput = document.getElementById('inputBrandName');
    const initialInput = document.getElementById('inputLogoInitial');
    const taglineInput = document.getElementById('inputTagline');
    const previewName = document.getElementById('previewName');
    const previewMark = document.getElementById('previewMark');
    const previewTagline = document.getElementById('previewTagline');

    nameInput?.addEventListener('input', (e) => {
        previewName.textContent = e.target.value || 'Marca';
        if (!initialInput.value && e.target.value) {
            previewMark.textContent = e.target.value.charAt(0).toUpperCase();
        }
    });

    initialInput?.addEventListener('input', (e) => {
        previewMark.textContent = (e.target.value || nameInput.value.charAt(0) || 'M').toUpperCase();
    });

    taglineInput?.addEventListener('input', (e) => {
        previewTagline.textContent = e.target.value || '';
    });
</script>
