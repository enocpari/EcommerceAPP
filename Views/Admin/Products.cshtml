@model List<EcommerceApp.Models.Product>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Gestión de Productos";
    var currentCat = ViewBag.CurrentCategory as string ?? "all";
}

<div style="max-width:1200px">
    <div class="row-between" style="flex-wrap:wrap;margin-bottom:20px;">
        <div>
            <p class="eyebrow">CATÁLOGO · INVENTARIO Y DISPONIBILIDAD</p>
            <h1 class="h1" style="font-size:26px;">Gestión de Productos (@Model.Count)</h1>
        </div>
        <div class="row" style="gap:10px;">
            <a asp-controller="Products" asp-action="Create" class="btn btn-accent btn-sm">+ Cargar nuevo producto</a>
        </div>
    </div>

    <!-- Filtros y Búsqueda -->
    <div class="table-actions" style="margin-bottom:16px;">
        <div class="row" style="gap:8px;flex-wrap:wrap;">
            <a asp-action="Products" asp-route-category="all" class="chip @(currentCat=="all"?"active":"")">Todos (@Model.Count)</a>
            <a asp-action="Products" asp-route-category="celular" class="chip @(currentCat=="celular"?"active":"")">📱 Celulares</a>
            <a asp-action="Products" asp-route-category="auricular" class="chip @(currentCat=="auricular"?"active":"")">🎧 Auriculares</a>
        </div>

        <form method="get" class="row" style="gap:8px;">
            <input type="hidden" name="category" value="@currentCat" />
            <input class="input" name="search" value="@ViewBag.CurrentSearch" placeholder="Buscar producto..." style="padding:6px 12px;font-size:12.5px;max-width:240px;border-radius:999px;" />
            <button type="submit" class="btn btn-secondary btn-sm">Buscar</button>
            @if (!string.IsNullOrEmpty(ViewBag.CurrentSearch as string))
            {
                <a asp-action="Products" asp-route-category="@currentCat" class="btn btn-ghost btn-sm">Limpiar</a>
            }
        </form>
    </div>

    <div class="table-wrap">
        <table class="ds-table">
            <thead>
                <tr>
                    <th style="width:48px;"></th>
                    <th>Producto & Marca</th>
                    <th>Categoría</th>
                    <th>Especificación Clave</th>
                    <th class="num-col">Precio ($)</th>
                    <th>Stock</th>
                    <th>Badge</th>
                    <th style="text-align:right;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" style="text-align:center;padding:36px;color:var(--muted);">
                            No se encontraron productos con los criterios especificados.
                        </td>
                    </tr>
                }
                @foreach (var item in Model)
                {
                    var isCel = (item.Category ?? "").ToLower().Contains("celular");
                    <tr>
                        <td>
                            <div style="width:40px;height:40px;border-radius:8px;background:var(--bg);border:1px solid var(--border);display:grid;place-items:center;overflow:hidden;">
                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                {
                                    <img src="@item.ImageUrl" alt="@item.Name" style="max-height:85%;max-width:85%;object-fit:contain" onerror="this.src='/images/default-product.jpg'" />
                                }
                                else if (isCel)
                                {
                                    <svg width="24" height="24" viewBox="0 0 44 44" fill="none"><rect x="11" y="3" width="22" height="38" rx="5" stroke="var(--fg)" stroke-width="1.6"/><rect x="15" y="8" width="14" height="2" rx="1" fill="var(--muted)"/><circle cx="22" cy="34" r="1.6" stroke="var(--muted)"/><rect x="14" y="13" width="16" height="16" rx="2" fill="color-mix(in oklch, var(--accent) 10%, transparent)" stroke="var(--border)"/></svg>
                                }
                                else
                                {
                                    <svg width="24" height="24" viewBox="0 0 44 44" fill="none"><path d="M8 18c0-7 6-11 14-11s14 4 14 11v6c0 2-1 3-2.5 4L22 35 10.5 28C9 27 8 26 8 24v-6z" stroke="var(--fg)" stroke-width="1.6"/><path d="M8 22c0 2 1 3 2.5 4L22 33l11.5-7C35 25 36 24 36 22" stroke="var(--muted)" stroke-width="1"/><circle cx="22" cy="19" r="5" fill="color-mix(in oklch, var(--accent) 10%, transparent)" stroke="var(--border)"/></svg>
                                }
                            </div>
                        </td>
                        <td>
                            <strong style="font-size:13.5px;">@item.Name</strong>
                            <div class="meta" style="font-size:11px;">Marca: @(item.Brand ?? "NODO")</div>
                        </td>
                        <td>
                            <span class="pill" style="font-size:10px;">@(isCel ? "Celular" : "Auricular")</span>
                        </td>
                        <td class="meta" style="font-size:12px;max-width:240px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis" title="@item.Spec">
                            @(item.Spec ?? "—")
                        </td>
                        <td class="num-col" style="font-weight:700;font-size:13.5px;">
                            $@item.Price.ToString("N0", new System.Globalization.CultureInfo("es-AR"))
                        </td>
                        <td>
                            @if (item.Stock > 5)
                            {
                                <span class="row" style="gap:6px;font-size:12px;">
                                    <span class="stock-dot dot-green"></span>
                                    <span>@item.Stock unid.</span>
                                </span>
                            }
                            else if (item.Stock > 0)
                            {
                                <span class="row" style="gap:6px;font-size:12px;color:#d97706;font-weight:600">
                                    <span class="stock-dot dot-amber"></span>
                                    <span>@item.Stock unid.</span>
                                </span>
                            }
                            else
                            {
                                <span class="row" style="gap:6px;font-size:12px;color:#dc2626;font-weight:600">
                                    <span class="stock-dot dot-red"></span>
                                    <span>Sin stock</span>
                                </span>
                            }
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.Badge))
                            {
                                <span class="tag" style="font-size:10.5px;padding:3px 7px;">@item.Badge</span>
                            }
                            else
                            {
                                <span class="meta" style="font-size:11px;">—</span>
                            }
                        </td>
                        <td style="text-align:right;white-space:nowrap;">
                            <a asp-controller="Products" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-secondary btn-sm" style="padding:4px 8px;font-size:11.5px;">Editar</a>
                            <a asp-controller="Products" asp-action="Details" asp-route-id="@item.Id" target="_blank" class="btn btn-ghost btn-sm" style="padding:4px 6px;font-size:11.5px;" title="Ver en tienda">↗</a>
                            <a asp-controller="Products" asp-action="Delete" asp-route-id="@item.Id" class="btn btn-ghost btn-sm" style="padding:4px 6px;font-size:11.5px;color:#dc2626;" title="Eliminar">✕</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
