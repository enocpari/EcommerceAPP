@model EcommerceApp.Models.Order
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = $"Detalle de Pedido #{Model.OrderNumber}";

    var statusClass = "s-pendiente";
    var s = Model.Status.ToLower();
    if (s.Contains("prepara") || s.Contains("empaqueta")) { statusClass = "s-preparando"; }
    else if (s.Contains("pago")) { statusClass = "s-pago"; }
    else if (s.Contains("camino") || s.Contains("transito") || s.Contains("tránsito")) { statusClass = "s-enviado"; }
    else if (s.Contains("entrega")) { statusClass = "s-entregado"; }
}

<div style="max-width:1160px;margin:0 auto;">
    <!-- Top breadcrumb & Actions -->
    <div style="display:flex;align-items:flex-start;justify-content:space-between;flex-wrap:wrap;gap:16px;margin-bottom:24px;">
        <div>
            <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px;">
                <a asp-action="Orders" class="btn btn-ghost btn-sm" style="display:inline-flex;align-items:center;gap:5px;padding:4px 8px;font-size:12px;">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
                    Volver a Pedidos
                </a>
                <span class="meta">/</span>
                <span class="order-code">#@Model.OrderNumber</span>
            </div>
            <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;">
                <h1 class="h1" style="font-size:26px;letter-spacing:-0.02em;margin:0;">Pedido #@Model.OrderNumber</h1>
                <span class="status @statusClass" style="font-size:12px;padding:4px 10px;">
                    <span class="status-dot"></span>@Model.Status
                </span>
            </div>
            <p class="meta" style="font-size:13px;margin-top:6px;">
                Registrado el @Model.CreatedAt.ToLocalTime().ToString("dd 'de' MMMM 'de' yyyy 'a las' HH:mm")
                @if (Model.UpdatedAt.HasValue)
                {
                    <span> · Actualizado: @Model.UpdatedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                }
            </p>
        </div>
        <div style="display:flex;align-items:center;gap:10px;">
            <button class="btn btn-secondary btn-sm" onclick="window.print()" style="display:inline-flex;align-items:center;gap:6px;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
                Imprimir
            </button>
            <a asp-action="EditOrder" asp-route-id="@Model.Id" class="btn btn-accent btn-sm" style="display:inline-flex;align-items:center;gap:6px;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                Editar Pedido
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div style="background:rgba(22,163,74,0.1);border:1px solid rgba(22,163,74,0.3);color:#15803d;padding:12px 18px;border-radius:12px;margin-bottom:20px;font-size:13.5px;font-weight:500;display:flex;align-items:center;gap:10px;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            @TempData["SuccessMessage"]
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.TransactionToken))
    {
        <div style="background:var(--surface);border:1px solid var(--accent);border-radius:14px;padding:14px 20px;margin-bottom:20px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;">
            <div style="display:flex;align-items:center;gap:10px;">
                <div style="width:32px;height:32px;border-radius:8px;background:rgba(0,0,0,0.04);color:var(--accent);display:grid;place-items:center;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                </div>
                <div>
                    <span class="meta" style="font-size:10.5px;text-transform:uppercase;letter-spacing:0.05em;display:block;">Token de Transacción / Recibo Oficial Compartido</span>
                    <span style="font-family:var(--font-mono);font-size:16px;font-weight:800;color:var(--accent);">@Model.TransactionToken</span>
                </div>
            </div>
            <div style="display:flex;align-items:center;gap:8px;">
                <button class="btn btn-secondary btn-sm" onclick="navigator.clipboard.writeText('@Model.TransactionToken'); window.NodoUI.showToast('✓ Token copiado al portapapeles');" style="display:inline-flex;align-items:center;gap:5px;font-size:12px;">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                    Copiar Token
                </button>
            </div>
        </div>
    }

    <!-- Main Grid: 2 columns (7 / 5) -->
    <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(320px, 1fr));gap:24px;align-items:start;">
        
        <!-- Left Col: Items and Quick Status Update -->
        <div class="stack" style="gap:20px;">
            
            <!-- Items Card -->
            <div class="card" style="padding:24px;border:1px solid var(--border);border-radius:var(--radius-lg);background:var(--surface);">
                <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;">
                    <h2 class="h2" style="font-size:17px;margin:0;display:flex;align-items:center;gap:8px;">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
                        Artículos del Pedido (@Model.Items.Count)
                    </h2>
                </div>

                <div class="table-wrap">
                    <table class="ds-table" style="margin-bottom:0;">
                        <thead>
                            <tr>
                                <th>Producto</th>
                                <th class="num-col">Precio Unit.</th>
                                <th class="num-col">Cant.</th>
                                <th class="num-col">Subtotal</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td>
                                        <div style="display:flex;align-items:center;gap:12px;">
                                            <div style="width:44px;height:44px;border-radius:10px;background:var(--bg);border:1px solid var(--border);display:grid;place-items:center;overflow:hidden;flex-shrink:0;">
                                                @if (!string.IsNullOrWhiteSpace(item.ProductImageUrl))
                                                {
                                                    <img src="@item.ProductImageUrl" alt="@item.ProductName" style="max-height:100%;max-width:100%;object-fit:contain;" />
                                                }
                                                else
                                                {
                                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" style="color:var(--muted);"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>
                                                }
                                            </div>
                                            <div>
                                                <div style="font-weight:700;font-size:13.5px;">@item.ProductName</div>
                                                @if (!string.IsNullOrWhiteSpace(item.ProductBrand) || !string.IsNullOrWhiteSpace(item.ProductSpec))
                                                {
                                                    <div class="meta" style="font-size:11.5px;margin-top:2px;">@item.ProductBrand @(!string.IsNullOrWhiteSpace(item.ProductSpec) ? $"· {item.ProductSpec}" : "")</div>
                                                }
                                            </div>
                                        </div>
                                    </td>
                                    <td class="num-col" style="font-size:13px;font-family:var(--font-mono);white-space:nowrap;">
                                        $@item.UnitPrice.ToString("N0")
                                    </td>
                                    <td class="num-col" style="font-weight:700;font-size:13px;">
                                        @item.Quantity
                                    </td>
                                    <td class="num-col" style="font-weight:800;font-size:13px;font-family:var(--font-mono);white-space:nowrap;color:var(--fg);">
                                        $@item.TotalPrice.ToString("N0")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Financial Summary -->
                <div style="margin-top:20px;padding-top:16px;border-top:1px solid var(--border);">
                    <div style="display:flex;justify-content:space-between;margin-bottom:8px;font-size:13.5px;">
                        <span class="meta">Subtotal de artículos:</span>
                        <span style="font-family:var(--font-mono);font-weight:600;">$@Model.Subtotal.ToString("N0")</span>
                    </div>
                    <div style="display:flex;justify-content:space-between;margin-bottom:12px;font-size:13.5px;">
                        <span class="meta">Costo de despacho:</span>
                        <span style="font-family:var(--font-mono);font-weight:600;color:#16a34a;">
                            @(Model.ShippingCost == 0 ? "Bonificado / $0" : $"${Model.ShippingCost:N0}")
                        </span>
                    </div>
                    <div style="display:flex;justify-content:space-between;padding-top:14px;border-top:2px solid var(--border);font-size:18px;font-weight:800;">
                        <span>Total del Pedido:</span>
                        <span style="font-family:var(--font-mono);color:var(--accent);">$@Model.Total.ToString("N0")</span>
                    </div>
                </div>
            </div>

            <!-- Quick Status Updater Card -->
            <div class="card" style="padding:22px;border:1px solid var(--border);border-radius:var(--radius-lg);background:var(--surface);">
                <div style="display:flex;align-items:center;gap:8px;margin-bottom:14px;">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
                    <h3 class="h3" style="font-size:15px;margin:0;">Actualizar Estado y Seguimiento</h3>
                </div>
                
                <form asp-action="UpdateOrderStatus" method="post" style="display:flex;flex-direction:column;gap:14px;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <input type="hidden" name="returnUrl" value="@Url.Action("OrderDetail", new { id = Model.Id })" />
                    
                    <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(200px, 1fr));gap:12px;">
                        <div>
                            <label class="meta" style="font-size:11.5px;font-weight:700;display:block;margin-bottom:4px;">Estado del Pedido</label>
                            <select name="status" class="form-control" style="width:100%;padding:9px 12px;border:1px solid var(--border);border-radius:10px;background:var(--bg);font-size:13px;">
                                <option value="Pendiente" selected="@(Model.Status == "Pendiente")">Pendiente</option>
                                <option value="Pago Acreditado" selected="@(Model.Status == "Pago Acreditado")">Pago Acreditado</option>
                                <option value="En preparación" selected="@(Model.Status == "En preparación")">En preparación</option>
                                <option value="En camino" selected="@(Model.Status == "En camino")">En camino</option>
                                <option value="Entregado" selected="@(Model.Status == "Entregado")">Entregado</option>
                                <option value="Cancelado" selected="@(Model.Status == "Cancelado")">Cancelado</option>
                            </select>
                        </div>
                        <div>
                            <label class="meta" style="font-size:11.5px;font-weight:700;display:block;margin-bottom:4px;">Código de Guía / Tracking</label>
                            <input type="text" name="trackingNumber" value="@Model.TrackingNumber" placeholder="Ej: TRK-8823901" class="form-control" style="width:100%;padding:9px 12px;border:1px solid var(--border);border-radius:10px;background:var(--bg);font-size:13px;font-family:var(--font-mono);" />
                        </div>
                    </div>

                    <div style="display:flex;justify-content:flex-end;">
                        <button type="submit" class="btn btn-secondary btn-sm" style="padding:9px 18px;font-weight:600;">
                            Guardar nuevo estado
                        </button>
                    </div>
                </form>
            </div>

        </div>

        <!-- Right Col: Customer Info, Shipping & Payment -->
        <div class="stack" style="gap:20px;">

            <!-- Customer Identity & Info Card -->
            <div class="card" style="padding:22px;border:1px solid var(--border);border-radius:var(--radius-lg);background:var(--surface);">
                <div style="display:flex;align-items:center;gap:8px;margin-bottom:14px;">
                    <div style="width:28px;height:28px;border-radius:8px;background:rgba(0,0,0,0.04);display:grid;place-items:center;color:var(--accent);">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                    </div>
                    <h2 class="h2" style="font-size:16px;margin:0;">Información del Cliente</h2>
                </div>

                <div class="stack" style="gap:12px;font-size:13px;">
                    <div>
                        <span class="meta" style="display:block;font-size:10.5px;text-transform:uppercase;letter-spacing:0.05em;">Nombre Completo</span>
                        <strong style="font-size:15px;color:var(--fg);">@Model.CustomerName</strong>
                    </div>

                    <!-- Highlighted Carnet de Identidad / DNI -->
                    <div style="background:var(--bg);border:1px solid var(--border);padding:12px 14px;border-radius:10px;">
                        <div style="display:flex;align-items:center;gap:6px;margin-bottom:4px;">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="9" cy="10" r="2"/><line x1="15" y1="8" x2="17" y2="8"/><line x1="15" y1="12" x2="17" y2="12"/><line x1="7" y1="16" x2="17" y2="16"/></svg>
                            <span class="meta" style="font-size:10.5px;text-transform:uppercase;letter-spacing:0.05em;font-weight:700;">Carnet de Identidad / DNI</span>
                        </div>
                        <div style="font-family:var(--font-mono);font-size:17px;font-weight:800;color:var(--accent);letter-spacing:0.02em;">
                            @Model.DocumentId
                        </div>
                    </div>

                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;">
                        <div>
                            <span class="meta" style="display:block;font-size:10.5px;text-transform:uppercase;letter-spacing:0.05em;">Teléfono / WhatsApp</span>
                            <a href="tel:@Model.Phone" style="color:var(--fg);font-weight:600;text-decoration:none;display:inline-flex;align-items:center;gap:4px;margin-top:2px;">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                                @Model.Phone
                            </a>
                        </div>
                        <div>
                            <span class="meta" style="display:block;font-size:10.5px;text-transform:uppercase;letter-spacing:0.05em;">Correo Electrónico</span>
                            <a href="mailto:@Model.Email" style="color:var(--fg);font-size:12px;word-break:break-all;text-decoration:none;display:block;margin-top:2px;">
                                @Model.Email
                            </a>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.UserId))
                    {
                        <div>
                            <span class="meta" style="display:block;font-size:10.5px;">Cuenta NODO vinculada:</span>
                            <span class="tag" style="font-size:10px;font-weight:600;margin-top:2px;">Usuario Registrado</span>
                        </div>
                    }
                </div>
            </div>

            <!-- Shipping & Location Card -->
            <div class="card" style="padding:22px;border:1px solid var(--border);border-radius:var(--radius-lg);background:var(--surface);">
                <div style="display:flex;align-items:center;gap:8px;margin-bottom:14px;">
                    <div style="width:28px;height:28px;border-radius:8px;background:rgba(0,0,0,0.04);display:grid;place-items:center;color:var(--accent);">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                    </div>
                    <h2 class="h2" style="font-size:16px;margin:0;">Ubicación y Entrega</h2>
                </div>

                <div class="stack" style="gap:12px;font-size:13px;">
                    <div>
                        <span class="meta" style="display:block;font-size:10.5px;text-transform:uppercase;letter-spacing:0.05em;">Dirección de Entrega</span>
                        <div style="font-weight:700;font-size:14px;color:var(--fg);margin-top:2px;">
                            @Model.Address
                        </div>
                    </div>

                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;">
                        <div>
                            <span class="meta" style="display:block;font-size:10.5px;text-transform:uppercase;letter-spacing:0.05em;">Ciudad / Municipio</span>
                            <strong>@Model.City</strong>
                        </div>
                        <div>
                            <span class="meta" style="display:block;font-size:10.5px;text-transform:uppercase;letter-spacing:0.05em;">Provincia / Departamento</span>
                            <strong>@Model.Province</strong>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.PostalCode))
                    {
                        <div>
                            <span class="meta" style="display:block;font-size:10.5px;text-transform:uppercase;letter-spacing:0.05em;">Código Postal</span>
                            <span style="font-family:var(--font-mono);font-weight:600;">@Model.PostalCode</span>
                        </div>
                    }

                    <div style="padding-top:10px;border-top:1px solid var(--border);">
                        <span class="meta" style="display:block;font-size:10.5px;text-transform:uppercase;letter-spacing:0.05em;">Método de Despacho</span>
                        <div style="font-weight:600;margin-top:3px;display:flex;align-items:center;gap:6px;">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                            @Model.ShippingMethod
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.TrackingNumber))
                    {
                        <div style="background:rgba(22,163,74,0.08);border:1px solid rgba(22,163,74,0.25);padding:10px 12px;border-radius:10px;">
                            <span class="meta" style="display:block;font-size:10.5px;color:#15803d;font-weight:700;">CÓDIGO DE GUÍA / TRACKING</span>
                            <span style="font-family:var(--font-mono);font-size:14px;font-weight:800;color:#15803d;">@Model.TrackingNumber</span>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.Notes))
                    {
                        <div style="background:var(--bg);border:1px solid var(--border);padding:10px 12px;border-radius:10px;">
                            <span class="meta" style="display:block;font-size:10.5px;text-transform:uppercase;letter-spacing:0.05em;">Indicaciones de entrega</span>
                            <div style="font-style:italic;margin-top:3px;">"@Model.Notes"</div>
                        </div>
                    }
                </div>
            </div>

            <!-- Payment Card -->
            <div class="card" style="padding:22px;border:1px solid var(--border);border-radius:var(--radius-lg);background:var(--surface);">
                <div style="display:flex;align-items:center;gap:8px;margin-bottom:14px;">
                    <div style="width:28px;height:28px;border-radius:8px;background:rgba(0,0,0,0.04);display:grid;place-items:center;color:var(--accent);">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
                    </div>
                    <h2 class="h2" style="font-size:16px;margin:0;">Método de Pago</h2>
                </div>

                <div class="stack" style="gap:10px;font-size:13px;">
                    <div>
                        <span class="meta" style="display:block;font-size:10.5px;text-transform:uppercase;letter-spacing:0.05em;">Modalidad Seleccionada</span>
                        <span class="tag" style="font-size:12px;font-weight:600;margin-top:4px;">@Model.PaymentMethod</span>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.PaymentReference))
                    {
                        <div style="background:var(--bg);border:1px solid var(--border);padding:10px 12px;border-radius:10px;">
                            <span class="meta" style="display:block;font-size:10.5px;text-transform:uppercase;letter-spacing:0.05em;color:var(--accent);font-weight:700;">N° Comprobante / Transacción</span>
                            <span style="font-family:var(--font-mono);font-size:14px;font-weight:700;">@Model.PaymentReference</span>
                        </div>
                    }

                    <div>
                        <span class="meta" style="display:block;font-size:10.5px;text-transform:uppercase;letter-spacing:0.05em;">Estado de la Operación</span>
                        <span class="status @statusClass" style="margin-top:4px;">
                            <span class="status-dot"></span>@Model.Status
                        </span>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.AdminNotes))
                    {
                        <div style="padding-top:10px;border-top:1px solid var(--border);">
                            <span class="meta" style="display:block;font-size:10.5px;text-transform:uppercase;letter-spacing:0.05em;">Notas de Auditoría Interna</span>
                            <div style="font-size:12px;background:rgba(255,255,255,0.03);padding:8px 10px;border-radius:8px;margin-top:4px;color:var(--fg);border:1px solid var(--border);">
                                @Model.AdminNotes
                            </div>
                        </div>
                    }
                </div>
            </div>

        </div>

    </div>
</div>
