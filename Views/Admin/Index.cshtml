@model List<EcommerceApp.Models.Product>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Panel de Control";
    var lowStock = ViewBag.LowStockProducts as List<EcommerceApp.Models.Product> ?? new();
}

<div style="max-width:1200px">
    <div class="row-between" style="flex-wrap:wrap;margin-bottom:20px;">
        <div>
            <p class="eyebrow">RESUMEN EJECUTIVO · HOY</p>
            <h1 class="h1" style="font-size:28px;">Todo bajo control.</h1>
        </div>
    </div>

    <!-- 4 KPI CARDS -->
    <div class="grid-4" style="margin-bottom:24px;">
        <div class="kpi">
            <div class="kpi-top">
                <span class="meta">Ventas (últimos 7 días)</span>
                <span class="pill" style="color:#16a34a;background:#dcfce7">+14% vs sem. ant.</span>
            </div>
            <div class="num kpi-value">@ViewBag.WeeklySales</div>
            <div class="kpi-label">Ticket promedio <span class="num" style="font-weight:700">@ViewBag.AverageTicket</span></div>
            <div class="kpi-spark">
                <i style="height:35%"></i><i style="height:48%"></i><i style="height:60%"></i><i style="height:42%"></i><i style="height:75%"></i><i style="height:88%"></i><i style="height:95%;background:var(--accent)"></i>
            </div>
        </div>

        <div class="kpi">
            <div class="kpi-top">
                <span class="meta">Pedidos pendientes</span>
                <span class="status s-pendiente"><span class="status-dot" style="background:#b45309"></span>Acción req.</span>
            </div>
            <div class="num kpi-value">@ViewBag.PendingOrders</div>
            <div class="kpi-label">3 pagos acreditados · 2 en preparación</div>
            <div class="row" style="margin-top:6px;">
                <a asp-action="Orders" class="btn btn-secondary btn-md btn-block">Revisar despachos →</a>
            </div>
        </div>

        <div class="kpi">
            <div class="kpi-top">
                <span class="meta">Stock crítico (&lt; 5 unid.)</span>
                <span class="status s-cancelado">Revisar</span>
            </div>
            <div class="num kpi-value" style="color:@(ViewBag.LowStockCount > 0 ? "#dc2626" : "var(--fg)")">@ViewBag.LowStockCount</div>
            <div class="kpi-label">@(ViewBag.OutOfStockCount > 0 ? $"{ViewBag.OutOfStockCount} productos agotados" : "Sin faltantes totales")</div>
            <div class="row" style="margin-top:6px;">
                <a asp-action="Inventory" class="btn btn-secondary btn-md btn-block">Ir a inventario →</a>
            </div>
        </div>

        <div class="kpi">
            <div class="kpi-top">
                <span class="meta">Modelos en catálogo</span>
                <span class="pill">Activos</span>
            </div>
            <div class="num kpi-value">@ViewBag.TotalProducts</div>
            <div class="kpi-label">Total unidades en stock: <span class="num" style="font-weight:700">@ViewBag.TotalStock</span></div>
            <div class="row" style="margin-top:6px;">
                <a asp-action="Products" class="btn btn-secondary btn-md btn-block">Gestionar productos →</a>
            </div>
        </div>
    </div>

    <!-- GRÁFICO SEMANAL & PEDIDOS RECIENTES -->
    <div class="grid-2-1" style="gap:24px;margin-bottom:28px;">
        <!-- Gráfico de Ventas -->
        <div class="card" style="padding:22px;">
            <div class="row-between">
                <div>
                    <h3 class="h3" style="font-size:16px;">Rendimiento semanal de ventas</h3>
                    <div class="meta" style="margin-top:2px;">Facturación acumulada lunes a domingo</div>
                </div>
                <span class="pill" style="font-size:11px;">Semana 37 · 2026</span>
            </div>
            <div class="bar-chart" style="margin-top:24px;height:140px;">
                <div class="bar" style="height:45%" data-v="$980k"></div>
                <div class="bar" style="height:62%" data-v="$1.2M"></div>
                <div class="bar" style="height:55%" data-v="$1.1M"></div>
                <div class="bar" style="height:70%" data-v="$1.4M"></div>
                <div class="bar" style="height:85%" data-v="$1.8M"></div>
                <div class="bar" style="height:90%" data-v="$1.9M"></div>
                <div class="bar active" style="height:100%" data-v="$2.1M"></div>
            </div>
            <div class="row-between meta" style="margin-top:8px;font-size:11px;font-family:var(--font-mono);">
                <span>LUN</span><span>MAR</span><span>MIÉ</span><span>JUE</span><span>VIE</span><span>SÁB</span><span>DOM (HOY)</span>
            </div>
        </div>

        <!-- Alerta de Stock Crítico -->
        <div class="card" style="padding:22px;">
            <div class="row-between" style="margin-bottom:12px;">
                <h3 class="h3" style="font-size:16px;">Stock prioritario</h3>
                <a asp-action="Inventory" class="meta" style="color:var(--accent);font-weight:600;">Ver todo →</a>
            </div>
            @if (lowStock.Any())
            {
                <div class="stack" style="gap:10px;">
                    @foreach (var item in lowStock)
                    {
                        <div class="row-between" style="padding:10px;background:var(--bg);border:1px solid var(--border);border-radius:10px;">
                            <div style="min-width:0;">
                                <div style="font-weight:600;font-size:13px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">@item.Name</div>
                                <div class="meta" style="font-size:11px;">@(item.Brand ?? "NODO") · $@item.Price.ToString("N0")</div>
                            </div>
                            <div class="row" style="gap:8px;">
                                @if (item.Stock == 0)
                                {
                                    <span class="status s-cancelado" style="font-size:10px;">Agotado</span>
                                }
                                else
                                {
                                    <span class="status s-pendiente" style="font-size:10px;">@item.Stock unid.</span>
                                }
                                <a asp-controller="Products" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-secondary btn-xs">Editar</a>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="meta" style="text-align:center;padding:24px 0;">Todos los productos cuentan con niveles de stock óptimos.</div>
            }
        </div>
    </div>

    <!-- PEDIDOS RECIENTES -->
    <div class="card" style="padding:22px;">
        <div class="row-between" style="margin-bottom:16px;flex-wrap:wrap;">
            <div>
                <h3 class="h3" style="font-size:16px;">Pedidos recientes en plataforma</h3>
                <div class="meta" style="margin-top:2px;">Últimas transacciones procesadas con MercadoPago y tarjetas</div>
            </div>
            <a asp-action="Orders" class="btn btn-secondary btn-md">Ver todos los pedidos</a>
        </div>

        <div class="table-wrap">
            <table class="ds-table">
                <thead>
                    <tr>
                        <th>N° Pedido / Token</th>
                        <th>Cliente / C.I.</th>
                        <th>Ítems</th>
                        <th>Fecha</th>
                        <th>Estado</th>
                        <th class="num-col">Total</th>
                        <th>Acción</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var recentOrders = ViewBag.RecentOrders as List<EcommerceApp.Models.Order> ?? new();
                    }
                    @if (recentOrders.Any())
                    {
                        @foreach (var order in recentOrders)
                        {
                            <tr>
                                <td>
                                    <strong style="font-family:var(--font-mono)">#@order.OrderNumber</strong>
                                    @if (!string.IsNullOrWhiteSpace(order.TransactionToken))
                                    {
                                        <div class="meta" style="font-size:10.5px;font-family:var(--font-mono);color:var(--accent);">@order.TransactionToken</div>
                                    }
                                </td>
                                <td>
                                    <strong>@order.CustomerName</strong>
                                    <div class="meta" style="font-size:11px">CI/DNI: @order.DocumentId · @order.City</div>
                                </td>
                                <td>
                                    <span class="tag" style="font-size:11px;">@order.Items.Count @(order.Items.Count == 1 ? "artículo" : "artículos")</span>
                                </td>
                                <td class="meta" style="font-size:12px;">@order.CreatedAt.ToLocalTime().ToString("dd/MM HH:mm")</td>
                                <td>
                                    <span class="status @(order.Status.Contains("Pendiente") ? "s-pendiente" : order.Status.Contains("Pago") ? "s-pago" : order.Status.Contains("Prepara") ? "s-preparando" : order.Status.Contains("Camino") ? "s-enviado" : order.Status.Contains("Entrega") ? "s-entregado" : "s-cancelado")">
                                        <span class="status-dot"></span>@order.Status
                                    </span>
                                </td>
                                <td class="num-col" style="font-weight:700;font-family:var(--font-mono);">$@order.Total.ToString("N0")</td>
                                <td>
                                    <a asp-action="OrderDetail" asp-route-id="@order.Id" class="btn btn-secondary btn-xs">Ver Detalle</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="meta" style="text-align:center;padding:24px;">No hay pedidos registrados en la plataforma.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
