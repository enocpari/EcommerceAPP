@model IEnumerable<EcommerceApp.Models.Order>
@{
    ViewData["Title"] = "Mis Pedidos · NODO";
}

<div class="container" style="max-width:1040px;padding:36px 16px 72px;">
    <div class="row-between" style="flex-wrap:wrap;gap:16px;margin-bottom:28px;">
        <div>
            <p class="eyebrow" style="color:var(--accent);margin-bottom:6px;">HISTORIAL DE COMPRAS</p>
            <h1 class="h1" style="font-size:28px;margin:0 0 6px;">Mis Pedidos Realizados</h1>
            <p class="meta" style="font-size:14px;">Consulta el estado, historial y detalles de todas tus compras en NODO</p>
        </div>
        <div>
            <a href="/Products" class="btn btn-accent btn-sm">Seguir Comprando</a>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div style="background:var(--surface);border:1px dashed var(--border);border-radius:20px;padding:54px 24px;text-align:center;max-width:560px;margin:32px auto;">
            <div style="font-size:48px;margin-bottom:12px;">🛍️</div>
            <h2 class="h2" style="font-size:20px;margin-bottom:8px;">Aún no has realizado pedidos</h2>
            <p class="meta" style="margin-bottom:24px;">Cuando compres algún producto desde tu carrito, podrás seguir su preparación y despacho aquí.</p>
            <a href="/Products" class="btn btn-accent" style="padding:12px 24px;">Explorar Catálogo</a>
        </div>
    }
    else
    {
        <div class="stack" style="gap:20px;">
            @foreach (var order in Model)
            {
                var statusClass = "s-pendiente";
                var s = order.Status.ToLower();
                if (s.Contains("prepara") || s.Contains("empaqueta")) { statusClass = "s-preparando"; }
                else if (s.Contains("pago")) { statusClass = "s-pago"; }
                else if (s.Contains("camino") || s.Contains("transito") || s.Contains("tránsito")) { statusClass = "s-enviado"; }
                else if (s.Contains("entrega")) { statusClass = "s-entregado"; }

                <div class="card" style="padding:24px;border:1px solid var(--border);border-radius:18px;background:var(--surface);">
                    <div class="row-between" style="flex-wrap:wrap;gap:14px;align-items:center;margin-bottom:16px;padding-bottom:14px;border-bottom:1px solid var(--border);">
                        <div style="display:flex;align-items:baseline;gap:12px;flex-wrap:wrap;">
                            <span style="font-family:var(--font-mono);font-size:18px;font-weight:700;color:var(--accent);">#@order.OrderNumber</span>
                            <span class="meta" style="font-size:12.5px;">@order.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                            @if (!string.IsNullOrWhiteSpace(order.TransactionToken))
                            {
                                <span class="tag" style="font-family:var(--font-mono);font-size:11px;font-weight:700;" title="Token de Transacción / Recibo">
                                    Token: @order.TransactionToken
                                </span>
                            }
                        </div>
                        <div style="display:flex;align-items:center;gap:10px;">
                            <span class="status @statusClass">
                                <span class="status-dot"></span>@order.Status
                            </span>
                            <a asp-action="Confirmation" asp-route-id="@order.Id" class="btn btn-ghost btn-sm" style="font-size:12px;padding:4px 10px;">Ver Comprobante</a>
                        </div>
                    </div>

                    <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(260px, 1fr));gap:20px;align-items:start;">
                        <div>
                            <span class="meta" style="font-size:11px;text-transform:uppercase;letter-spacing:0.5px;display:block;margin-bottom:6px;">Artículos Comprados</span>
                            <div class="stack" style="gap:8px;">
                                @foreach (var item in order.Items)
                                {
                                    <div style="display:flex;align-items:center;gap:10px;font-size:13px;">
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color:var(--muted);flex-shrink:0;"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>
                                        <div style="flex:1;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                                            <strong>@item.ProductName</strong> <span class="meta">(x@item.Quantity)</span>
                                        </div>
                                        <div style="font-family:var(--font-mono);font-weight:600;">$@item.TotalPrice.ToString("N0")</div>
                                    </div>
                                }
                            </div>
                        </div>

                        <div>
                            <span class="meta" style="font-size:11px;text-transform:uppercase;letter-spacing:0.5px;display:block;margin-bottom:6px;">Detalles de Envío y Documento</span>
                            <div style="font-size:13px;line-height:1.6;">
                                <div><strong>Destinatario:</strong> @order.CustomerName</div>
                                <div><strong>Carnet / DNI:</strong> <span style="font-family:var(--font-mono);font-weight:600;">@order.DocumentId</span></div>
                                <div><strong>Token Oficial:</strong> <span style="font-family:var(--font-mono);font-weight:700;color:var(--accent);">@order.TransactionToken</span></div>
                                <div><strong>Dirección:</strong> @order.Address, @order.City</div>
                                @if (!string.IsNullOrWhiteSpace(order.TrackingNumber))
                                {
                                    <div style="margin-top:4px;color:#16a34a;font-weight:600;font-family:var(--font-mono);font-size:12px;">
                                        📦 Guía de seguimiento: @order.TrackingNumber
                                    </div>
                                }
                            </div>
                        </div>

                        <div style="text-align:right;">
                            <span class="meta" style="font-size:11px;text-transform:uppercase;letter-spacing:0.5px;display:block;margin-bottom:4px;">Total Pagado</span>
                            <div style="font-family:var(--font-mono);font-size:22px;font-weight:800;color:var(--fg);">$@order.Total.ToString("N0")</div>
                            <span class="tag" style="font-size:10.5px;margin-top:4px;">@order.PaymentMethod</span>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
