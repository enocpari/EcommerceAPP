@model EcommerceApp.Models.Order?
@{
    ViewData["Title"] = "Rastrear Pedido · NODO";
    var hasSearched = (bool)(ViewBag.HasSearched ?? false);
    var searchedNumber = (string?)ViewBag.SearchedNumber ?? "";
    var searchedDoc = (string?)ViewBag.SearchedDoc ?? "";
}

<div class="container" style="max-width:760px;padding:36px 16px 72px;">
    <div style="text-align:center;margin-bottom:32px;">
        <p class="eyebrow" style="color:var(--accent);margin-bottom:6px;">LOGÍSTICA Y ENVIOS</p>
        <h1 class="h1" style="font-size:28px;margin:0 0 8px;">Rastreo y Estado de Pedido</h1>
        <p class="meta" style="font-size:14px;max-width:500px;margin:0 auto;">
            Consulta el estado de preparación, número de guía o fecha de entrega ingresando los datos de tu compra.
        </p>
    </div>

    <!-- Search Box -->
    <div class="card" style="padding:24px;border:1px solid var(--border);border-radius:18px;background:var(--surface);margin-bottom:28px;">
        <form method="get" asp-action="Track" style="display:flex;flex-direction:column;gap:14px;">
            <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(220px, 1fr));gap:12px;">
                <div>
                    <label class="form-label" style="display:block;font-size:12.5px;font-weight:600;margin-bottom:6px;">N° de Pedido o Token de Transacción *</label>
                    <input type="text" name="orderNumber" required value="@searchedNumber" placeholder="Ej: NOD-9402 o TRX-9402-A8F7..." class="form-control" style="width:100%;padding:10px 14px;border:1px solid var(--border);border-radius:10px;background:var(--bg);font-size:13.5px;font-family:var(--font-mono);" />
                </div>
                <div>
                    <label class="form-label" style="display:block;font-size:12.5px;font-weight:600;margin-bottom:6px;">Carnet de Identidad / DNI (Opcional)</label>
                    <input type="text" name="documentId" value="@searchedDoc" placeholder="Ej: 10482914" class="form-control" style="width:100%;padding:10px 14px;border:1px solid var(--border);border-radius:10px;background:var(--bg);font-size:13.5px;font-family:var(--font-mono);" />
                </div>
            </div>
            <button type="submit" class="btn btn-accent" style="padding:11px 20px;font-size:14px;font-weight:600;display:inline-flex;align-items:center;justify-content:center;gap:6px;">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                Consultar Estado y Comprobante
            </button>
        </form>
    </div>

    @if (hasSearched)
    {
        if (Model == null)
        {
            <div style="background:var(--surface);border:1px dashed var(--border);border-radius:18px;padding:36px 20px;text-align:center;">
                <div style="width:48px;height:48px;border-radius:50%;background:var(--bg);border:1px solid var(--border);display:grid;place-items:center;margin:0 auto 12px;color:var(--muted);">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                </div>
                <h3 class="h3" style="font-size:17px;margin-bottom:6px;">Pedido no encontrado</h3>
                <p class="meta" style="font-size:13px;max-width:440px;margin:0 auto 16px;">
                    No encontramos ningún pedido registrado con "<strong>@searchedNumber</strong>". Verifica los dígitos del comprobante o ingresa tu token de transacción.
                </p>
                <a href="/Products" class="btn btn-secondary btn-sm">Ir al Catálogo</a>
            </div>
        }
        else
        {
            var statusClass = "s-pendiente";
            var s = Model.Status.ToLower();
            if (s.Contains("prepara") || s.Contains("empaqueta")) { statusClass = "s-preparando"; }
            else if (s.Contains("pago")) { statusClass = "s-pago"; }
            else if (s.Contains("camino") || s.Contains("transito") || s.Contains("tránsito")) { statusClass = "s-enviado"; }
            else if (s.Contains("entrega")) { statusClass = "s-entregado"; }

            <div class="card" style="padding:24px;border:1px solid var(--border);border-radius:18px;background:var(--surface);">
                <div class="row-between" style="flex-wrap:wrap;gap:12px;margin-bottom:16px;padding-bottom:14px;border-bottom:1px solid var(--border);">
                    <div>
                        <span class="meta" style="font-size:11px;text-transform:uppercase;">Pedido Registrado</span>
                        <div style="font-family:var(--font-mono);font-size:20px;font-weight:700;color:var(--accent);">#@Model.OrderNumber</div>
                    </div>
                    <div>
                        <span class="status @statusClass" style="font-size:13px;padding:5px 12px;">
                            <span class="status-dot"></span>@Model.Status
                        </span>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.TransactionToken))
                {
                    <div style="background:var(--bg);border:1px solid var(--border);padding:10px 14px;border-radius:10px;margin-bottom:14px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px;">
                        <div>
                            <span class="meta" style="font-size:10.5px;text-transform:uppercase;">Token de Transacción / Recibo</span>
                            <div style="font-family:var(--font-mono);font-size:14px;font-weight:700;color:var(--fg);">@Model.TransactionToken</div>
                        </div>
                        <button type="button" class="btn btn-secondary btn-sm" onclick="navigator.clipboard.writeText('@Model.TransactionToken'); window.NodoUI.showToast('✓ Token copiado');" style="font-size:11.5px;padding:3px 8px;">
                            Copiar
                        </button>
                    </div>
                }

                <div class="stack" style="gap:14px;font-size:13px;">
                    <div>
                        <strong>Cliente:</strong> @Model.CustomerName
                        <span class="meta">(CI/DNI: @Model.DocumentId)</span>
                    </div>
                    <div>
                        <strong>Destino de entrega:</strong> @Model.Address, @Model.City, @Model.Province
                    </div>
                    <div>
                        <strong>Método de Envío:</strong> @Model.ShippingMethod
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.TrackingNumber))
                    {
                        <div style="background:rgba(22,163,74,0.1);border:1px solid rgba(22,163,74,0.3);color:#15803d;padding:10px 14px;border-radius:10px;font-family:var(--font-mono);font-weight:700;">
                            Código de Guía: @Model.TrackingNumber
                        </div>
                    }
                    <div class="row-between" style="padding-top:10px;border-top:1px solid var(--border);font-weight:700;">
                        <span>Total:</span>
                        <span style="font-family:var(--font-mono);font-size:16px;color:var(--accent);">$@Model.Total.ToString("N0")</span>
                    </div>
                </div>
            </div>
        }
    }
</div>
